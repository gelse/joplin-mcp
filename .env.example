# =============================================================================
# Joplin API — Environment Variables
# =============================================================================
# Used by the single combined container (joplin-mcp).

# Joplin Server sync target URL
JOPLIN_SERVER_URL=https://joplin.example.com/

# Joplin Server credentials
JOPLIN_USERNAME=your-email@example.com
JOPLIN_PASSWORD=your-password

# Joplin Data API port (internal, default: 41184)
# The Data API binds to loopback inside the container; this is rarely changed.
JOPLIN_DATA_API_PORT=41184

# Joplin API token (optional)
# When set, the entrypoint uses this value directly.
# When unset, the token is auto-extracted from the Joplin CLI config / settings.json.
# JOPLIN_API_TOKEN=your-api-token

# Log level: debug, info, warn, error, or silent (default: info)
LOG_LEVEL=info

# Sync interval in seconds (default: 300)
SYNC_INTERVAL_SECONDS=300

# Maximum number of items that sync may delete before the circuit breaker
# trips and halts further syncs (default: 100).  Set to -1 to disable the
# deletion circuit breaker (0 is a valid threshold: it trips on any deletion).
# See issue #27.
# SYNC_MAX_DELETE_COUNT=100

# Host-side MCP port (default: 3000)
# The container always listens on internal port 3000; this controls the published host port.
MCP_HOST_PORT=3000

# E2EE master password (optional)
# Set when End-to-End Encryption is enabled on Joplin Server.
# Leave empty to skip (no encryption).
# JOPLIN_MASTER_PASSWORD=
