FROM node:22-bookworm-slim
WORKDIR /app

# pnpm is pinned (not @latest) for reproducibility: pnpm-lock.yaml is
# lockfileVersion 9.0 and newer pnpm majors may change --frozen-lockfile
# semantics. Keep the pin in sync with the lockfile's major.
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

# vitest.config.ts drives the unit suite: include tests/**/*.test.ts,
# exclude tests/container/**.
COPY tsconfig.json tsconfig.build.json vitest.config.ts ./
COPY src/ src/
COPY tests/ tests/
# Copied only so the unit-suite structural tests can read these files at
# runtime (tests/integration-runner-config.test.ts,
# tests/docker-test-config.test.ts, and
# tests/periodic-sync-e2ee-decrypt.test.ts, which pins the entrypoint's
# periodic E2EE decrypt structure); they are NOT executed by the unit suite.
COPY docker-compose.test.yml Makefile Dockerfile.unittests entrypoint-combined.sh ./
COPY scripts/ scripts/

RUN pnpm run build
RUN mkdir -p /app/reports

# Note: no Docker CLI package is installed here — only the container
# integration flow needs it (see Dockerfile.tests). This image runs the
# unit suite exclusively.

# Runs `vitest run` (the unit suite only). RUN_INTEGRATION_TESTS is
# intentionally not set anywhere in this image: tests/integration.test.ts
# self-skips unless that env var is truthy.
CMD ["pnpm", "run", "test"]
