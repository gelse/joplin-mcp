# =============================================================================
# Combined single-container: joplin-core + joplin-mcp
# =============================================================================
# Merges the Joplin CLI + Data API (core) and MCP HTTP server (mcp) into one
# container. The Data API binds directly to loopback (127.0.0.1).
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build TypeScript application (same as Dockerfile.mcp builder)
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /build

# Install pnpm
RUN npm install -g "pnpm@9"

# Copy dependency manifests first (layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --no-frozen-lockfile --ignore-scripts

# Copy all source
COPY tsconfig.json tsconfig.build.json ./
COPY src/ ./src/
# Tests run in CI and in the test container, not in the image build.
RUN pnpm run build

# ---------------------------------------------------------------------------
# Stage 2: Production runtime
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim

# Install system dependencies required by Joplin CLI
# libsecret-1-0: for credential storage (keychain integration)
# ca-certificates: for HTTPS connections to Joplin Server
# curl: for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsecret-1-0 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pin Joplin CLI version identically to Dockerfile.core
ARG JOPLIN_CLI_VERSION=3.6.2

# Install pnpm and Joplin CLI globally
RUN npm install -g "pnpm@9" "joplin@${JOPLIN_CLI_VERSION}"

# Create non-root user for security.
# The node base image reserves uid/gid 1000 for the `node` user, so
# useradd assigns uid/gid 1001 by default. This matches Dockerfile.core
# and preserves compatibility with existing joplin_data volumes.
# Do NOT pass --uid/--gid to pin 1000 — that collides with the node user.
RUN useradd --create-home --shell /bin/bash joplin

# Set up application directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder /build/dist ./dist

# Copy dependency manifests and install production dependencies only
COPY --from=builder /build/package.json /build/pnpm-lock.yaml ./
RUN pnpm install --no-frozen-lockfile --prod

# Copy combined entrypoint script
COPY entrypoint-combined.sh ./
RUN chmod +x entrypoint-combined.sh

# Create log directory for Joplin CLI output
RUN mkdir -p /var/log/joplin && chown -R joplin:joplin /var/log/joplin

# Create data directory for Joplin profile
RUN mkdir -p /home/joplin/.config/joplin && chown -R joplin:joplin /home/joplin /app /var/log/joplin

# Switch to non-root user
USER joplin

# Expose MCP server port only.  The Data API binds to 127.0.0.1 (loopback)
# inside the container, so port 41184 is not exposed to the host.
EXPOSE 3000

# Health check: verify both MCP server and Data API are responding.
# NOTE: Probes the default ports only; does not honour JOPLIN_DATA_API_PORT
# or MCP_PORT overrides — matches core's existing healthcheck pattern.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=90s \
    CMD curl -f http://127.0.0.1:41184/ping && curl -f http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["./entrypoint-combined.sh"]
